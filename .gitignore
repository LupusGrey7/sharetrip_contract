# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Keep oapi-codegen output trackable (global gitignore may hide IDEA's gen/):
!/gen/
!/gen/**
# .docs/ — только локально (конспекты/cheatsheets), в remote не пушим (см. global ignore)

#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test
build/

# Orphan .go leftovers after copying project folder between machines (not in git)
_orphan_backup_*/

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
vendor/
go/pkg/

# Go workspace file
go.work
go.work.sum

# env file (keep templates / safe test env in git)
.env*
!.env.example
.env.test
.active-app-env

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
*.iml

# Local development files
docs/
develop/
deploy/
deploy/docker-compose.yml
tmp/
project_info/
scripts/
api/postman_collections/

#logs
deploy/logs/
deploy/logs/

#sqruff for lint sql script
.sqruff