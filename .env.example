# Copy to .env.dev / .env.prod and fill real values.
# Select profile: make <target> APP_ENV=dev|prod|test

ENV=development
HTTP_PORT=8082

# OpenTelemetry → shared ShareTrip stack (share_trip_otel_collector on host :4319)
OTEL_SERVICE_NAME=sharetrip-contract
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=local
OTEL_EXPORTER_ENDPOINT=localhost:4319

DB_DRIVER=postgres
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=6547
DB_NAME=sharetrip_contract
DB_SSLMODE=disable

# Concrete URL (no {placeholders})
DATABASE_URL=postgres://postgres:password@localhost:6547/sharetrip_contract?sslmode=disable
